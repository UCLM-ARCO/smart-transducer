#!/usr/bin/python3 -u
# -*- mode: python; coding: utf-8 -*-

import sys
import Ice

from stlib import stslice


class LinkableSet(Ice.Application):
    def run(self, args):
        if len(args) < 3:
            print("Usage: {} <subject_prx> <observer_prx>".format(args[0]))
            return 1

        subject = self.get_subject_proxy(args[1])
        subject.linkto(args[2])
        print("+'{}'\n+------> '{}'".format(subject, args[2]))

    def get_subject_proxy(self, strprx):
        ic = self.communicator()
        proxy = ic.stringToProxy(strprx)
        return stslice.LinkablePrx.uncheckedCast(proxy)


if __name__ == "__main__":
    LinkableSet().main(sys.argv)

